# Secrets. Never commit.
.env

# Node tooling (dev only).
node_modules/
package-lock.json

# Real uploads (keep the folders and their .htaccess, ignore the content).
uploads/*/*
!uploads/*/.gitkeep
!uploads/*/.htaccess

# Logs and OS cruft.
*.log
# Exception: release evidence logs ARE the deliverable (PR7, M13). Scoped to the
evidence directory only; real error logs stay ignored.
!docs/evidence/**/*.log
error_log
.DS_Store
Thumbs.db

# Build and transfer artifacts.
*.tar.gz
_to_delete/

# NOTE: vendor/ is committed on purpose. The cPanel server has no Composer.
# NOTE: assets/css/tailwind.css and assets/js/*.min.js are committed (built here).
