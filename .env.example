# =============================================================================
# OK Veggies. Environment configuration (template).
# Copy this file to .env and fill in the real values. Commit THIS file, not .env.
# =============================================================================

# --- APPLICATION -------------------------------------------------------------
APP_URL=https://okveggies.com.ng
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Africa/Lagos
CURRENCY=NGN

# --- DATABASE (cPanel MySQL / MariaDB) ---------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password
DB_CHARSET=utf8mb4

# --- SESSION -----------------------------------------------------------------
SESSION_LIFETIME_MINUTES=480
SESSION_COOKIE_NAME=okv_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# --- SECURITY ----------------------------------------------------------------
BCRYPT_COST=12
CSRF_TOKEN_LENGTH=32
# Generate once: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Password policy (Password helper). Length carries the weight, so we do not
# force a character mix. A minimum of 8 is enforced in code even if set lower.
PASSWORD_MIN_LENGTH=10

# Login throttling (RateLimiter), by identifier and by IP, over a window in
# seconds. A locked attempt is refused even with the right password.
LOGIN_MAX_PER_IDENTIFIER=5
LOGIN_MAX_PER_IP=20
LOGIN_WINDOW_SECONDS=900

# Secret for the web migration runner (public/migrate.php) on shell-less hosting.
# The deploy workflow sends this to apply migrations after an upload.
# Generate a strong value: openssl rand -hex 32
MIGRATE_TOKEN=

# One-time secret for the first-Owner setup page (public/setup.php) on shell-less
# hosting. Set it, create the Owner at /public/setup.php?token=... , then REMOVE
# this line. The page also refuses the moment any staff user exists.
# Generate a strong value: openssl rand -hex 32
SETUP_TOKEN=

# --- SMTP EMAIL (order confirmations, activation codes) ----------------------
SMTP_HOST=mail.okveggies.com.ng
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=noreply@okveggies.com.ng
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@okveggies.com.ng
SMTP_FROM_NAME=OK Veggies

# --- PAYSTACK ----------------------------------------------------------------
# The secret key is the one that matters. It authenticates every API call AND
# it is the key Paystack signs webhooks with, so there is no separate webhook
# secret to set. Use the sk_test_ pair until a full test mode payment has run
# end to end: the ledger stamps the mode on every transaction and refuses to
# let a test event credit a live order, or the reverse.
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx

# Not read by anything yet. It is needed only for the Paystack Inline popup,
# which is a later enhancement; the hosted redirect we use today needs just the
# secret key. Safe to fill in now.
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxx

# --- SUPPORT / WHATSAPP -------------------------------------------------------
WHATSAPP_SUPPORT_NUMBER=2348000000000

# --- FILE UPLOADS ------------------------------------------------------------
UPLOAD_MAX_BYTES=5242880

# --- ERROR LOGGING -----------------------------------------------------------
LOG_ERRORS=true
DISPLAY_ERRORS=false
# Keep the log outside public_html on the live server.
ERROR_LOG_PATH=/home/youruser/logs/okveggies_error.log
