# =============================================================================
# OK Veggies. Disposable test environment for the release gate.
#
# Copy to .env for a local release run, or let CI do it:
#   cp scripts/tests/ci.env.example .env
#
# Every value here is a test value and none of it is a secret: the database is a
# throwaway, the mail is captured by a local sink, and the Paystack key is a
# test-mode string that never leaves 127.0.0.1. This file is committed on
# purpose so that a release run is reproducible by anyone. The real .env stays
# out of the repository, as CLAUDE.md requires.
#
# DB_NAME must end in _test: scripts/tests/db_reset.php refuses to drop tables
# anywhere else, and the release gate refuses to start against it.
# =============================================================================

# --- APPLICATION -------------------------------------------------------------
APP_URL=http://127.0.0.1:8123
APP_ENV=testing
APP_DEBUG=false
APP_TIMEZONE=Africa/Lagos
CURRENCY=NGN

# --- DATABASE (a disposable MySQL 8) -----------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=okveggies_test
DB_USER=okv
DB_PASS=okv_test_pw
DB_CHARSET=utf8mb4

# --- SESSION -----------------------------------------------------------------
SESSION_LIFETIME_MINUTES=480
SESSION_COOKIE_NAME=okv_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# --- SECURITY ----------------------------------------------------------------
# The one reader of BCRYPT_COST is Password::cost(), which floors at 10 and
# caps at 14, so a value under 10 is clamped and changes nothing. Anything below
# 10 also contradicts PasswordTest, which asserts that a cost-10 hash needs a
# rehash at the configured cost. 11 keeps fixture hashing quick while staying
# honest about the floor. Production keeps 12.
BCRYPT_COST=11
CSRF_TOKEN_LENGTH=32
APP_ENCRYPTION_KEY=Y2ktdGVzdC1rZXktbm90LWEtc2VjcmV0LTMyYnl0ZXM=
PASSWORD_MIN_LENGTH=10

LOGIN_MAX_PER_IDENTIFIER=5
LOGIN_MAX_PER_IP=20
LOGIN_WINDOW_SECONDS=900

# The migration and cron endpoints fail closed without a token. Test values.
MIGRATE_TOKEN=ci-test-migrate-token
SETUP_TOKEN=ci-test-setup-token

# --- SMTP (the local sink started by the release gate) -----------------------
SMTP_HOST=127.0.0.1
SMTP_PORT=2525
SMTP_ENCRYPTION=none
SMTP_USER=sink@example.test
SMTP_PASS=sink
SMTP_FROM_EMAIL=noreply@example.test
SMTP_FROM_NAME=OK Veggies
SMTP_TIMEOUT=5

# --- PAYSTACK (test mode, pointed at the approved stand-in) ------------------
# Paystack::base() honours PAYSTACK_BASE_URL only when the key is a test key, so
# a live key can never be aimed at the stand-in by accident.
PAYSTACK_SECRET_KEY=sk_test_okveggies_release_gate_only
PAYSTACK_BASE_URL=http://127.0.0.1:8124
PAYSTACK_PUBLIC_KEY=pk_test_okveggies_release_gate_only

# --- SUPPORT / WHATSAPP ------------------------------------------------------
WHATSAPP_SUPPORT_NUMBER=2348000000000

# --- FILE UPLOADS ------------------------------------------------------------
UPLOAD_MAX_BYTES=5242880

# --- ERROR LOGGING -----------------------------------------------------------
LOG_ERRORS=true
DISPLAY_ERRORS=false
ERROR_LOG_PATH=/tmp/okv-release-gate-error.log
