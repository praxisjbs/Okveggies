# =============================================================================
# OK Veggies .htaccess (Apache / cPanel shared hosting)
# HTTPS, security headers, and deny access to everything that is not meant to be
# reached over the web (secrets, source, migrations, docs, tooling).
# =============================================================================

Options -Indexes

# --- Force HTTPS -------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Fail closed before any front-controller or HTTPS rewrite. This is kept in
    # mod_rewrite as well as RedirectMatch below because shared hosts do not
    # always permit mod_alias directives in per-directory configuration.
    RewriteRule ^(?:includes|migrations|scripts|docs|vendor|node_modules)(?:/|$) - [F,L,NC]

    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # One slashless public form for every M12 content route.
    RewriteRule ^(our-story|how-it-works|faq|terms|privacy|delivery-policy)/$ /$1 [R=301,L,NE]

    # M12 canonical content routes. THE_REQUEST limits these redirects to old
    # browser-facing URLs, so the internal clean-route rewrites cannot loop.
    RewriteCond %{THE_REQUEST} \s/+page\.php\? [NC]
    RewriteCond %{QUERY_STRING} (^|&)slug=about(&|$) [NC]
    RewriteRule ^page\.php$ /our-story? [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+page\.php\? [NC]
    RewriteCond %{QUERY_STRING} (^|&)slug=how-it-works(&|$) [NC]
    RewriteRule ^page\.php$ /how-it-works? [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+page\.php\? [NC]
    RewriteCond %{QUERY_STRING} (^|&)slug=faq(&|$) [NC]
    RewriteRule ^page\.php$ /faq? [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+page\.php\? [NC]
    RewriteCond %{QUERY_STRING} (^|&)slug=terms(&|$) [NC]
    RewriteRule ^page\.php$ /terms? [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+page\.php\? [NC]
    RewriteCond %{QUERY_STRING} (^|&)slug=privacy(&|$) [NC]
    RewriteRule ^page\.php$ /privacy? [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+page\.php\? [NC]
    RewriteCond %{QUERY_STRING} (^|&)slug=delivery-policy(&|$) [NC]
    RewriteRule ^page\.php$ /delivery-policy? [R=301,L]

    RewriteRule ^our-story/?$ page.php?slug=about [END,QSA]
    RewriteRule ^how-it-works/?$ page.php?slug=how-it-works [END,QSA]
    RewriteRule ^faq/?$ page.php?slug=faq [END,QSA]
    RewriteRule ^terms/?$ page.php?slug=terms [END,QSA]
    RewriteRule ^privacy/?$ page.php?slug=privacy [END,QSA]
    RewriteRule ^delivery-policy/?$ page.php?slug=delivery-policy [END,QSA]
    RewriteRule ^sitemap\.xml$ sitemap.php [END]
</IfModule>

# --- Security headers (bootstrap.php also sets these from PHP) ----------------
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# --- Deny dotfiles (including .env) ------------------------------------------
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# --- Deny source and data by extension ---------------------------------------
<FilesMatch "\.(sql|md|sh|mjs|json|lock|ini|log|dist)$">
    Require all denied
</FilesMatch>
# index.php and the app still work; those are served, not matched above.

# --- Deny server-only directories --------------------------------------------
RedirectMatch 403 ^/(includes|migrations|scripts|docs|vendor|node_modules)(/|$)

# --- Let the uploads folder serve files but never execute PHP ----------------
# (uploads/.htaccess enforces the no-execution rule.)

# --- Correct MIME types for the brand assets ---------------------------------
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType font/woff2 .woff2
    AddType image/svg+xml .svg
</IfModule>

# --- Long-cache the fingerprinted static assets (okv_asset appends ?v=) -------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType font/woff2   "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/png    "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
</IfModule>
